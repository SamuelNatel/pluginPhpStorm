<idea-plugin>
    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="samuel.natel20@gmail.com" url="https://github.com/SamuelNatel">Samuel Natel</vendor>
    <id>com.program.toDoList</id>
    <name>To-Do List</name>

    <description>
        "A simple To-Do list plugin for PhpStorm"
    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
      <toolWindow
              id="ToDoList"
              anchor="right"
              factoryClass="com.program.ToDoListToolWindowFactory"
              icon="AllIcons.Actions.ListFiles"
      />
    </extensions>

    <version>1.1</version>

    <idea-version since-build="222.3345.118" until-build="241.*"/>
</idea-plugin>